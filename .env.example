ANTHROPIC_API_KEY=your-key-here
# Recommended when deployed publicly: require this passphrase for /api calls
APP_PASSWORD=
# Optional. MODEL is used for questions and model answers.
# FEEDBACK_MODEL is used for the end-of-session feedback (defaults to MODEL).
# Cheap + good mix: MODEL=claude-haiku-5-5, FEEDBACK_MODEL=claude-sonnet-5-5
MODEL=claude-sonnet-5-5
FEEDBACK_MODEL=
PORT=3000
